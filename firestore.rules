rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Hardened rules would go here. 
    // Given the urgency and lack of explicit Auth UI in user's previous steps,
    // we start with open rules then tighten.
  }
}
